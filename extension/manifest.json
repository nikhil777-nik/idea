{
  "manifest_version": 3,
  "name": "Auto Cursor Replay",
  "version": "2.0.0",
  "description": "Controls and replays actual Windows system mouse cursor movements using Chrome Native Messaging.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
